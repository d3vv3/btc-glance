# Node 24; persistent local disk, shared by Next and the independent worker.
DATA_DIR=./data
# Match the browser URL exactly. Use npm run dev -- --hostname 127.0.0.1 --port 3106.
# Production MUST set its public HTTPS origin, e.g. https://weather.example.com.
# No trailing slash, path, credentials, query, or fragment. Restart after changes.
APP_ORIGIN=http://localhost:3106
# Secure cookies stay enabled; HTTP is permitted only for literal localhost.
# Do not use a LAN IP, 127.0.0.1 URL, or a custom HTTP hostname in the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com
COLLECT_INTERVAL_SECONDS=60
STALE_SECONDS=300
# Explicit illustrative fixtures, never automatically used on live failures.
DEMO_MODE=false
